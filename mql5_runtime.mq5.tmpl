struct RuleNode {
   string op;
   int a,b,c;
   double number;
   string field;
   double v[];
};
struct FeatureColumn { double v[]; };
RuleNode nodes[];
FeatureColumn features[];
string feature_names[];
MqlRates bars[];
CTrade trade;
datetime last_bar=0;
datetime last_evaluation=0;
bool await_first_bar=false;

bool Valid(double x) { return x!=EMPTY_VALUE && MathIsValidNumber(x); }
bool Yes(double x) { return Valid(x) && x!=0.0; }
bool No(double x) { return Valid(x) && x==0.0; }
double Clean(double x) { return Valid(x) ? x : EMPTY_VALUE; }
double Both(double a,double b) {
   if(No(a) || No(b)) return 0.0;
   return Valid(a) && Valid(b) ? 1.0 : EMPTY_VALUE;
}
double Either(double a,double b) {
   if(Yes(a) || Yes(b)) return 1.0;
   return Valid(a) && Valid(b) ? 0.0 : EMPTY_VALUE;
}
datetime UtcTime(datetime t) { return t-BrokerUtcOffsetMinutes*60; }

void SetNode(int id,string op,int a,int b,int c,double number,string field) {
   nodes[id].op=op; nodes[id].a=a; nodes[id].b=b; nodes[id].c=c;
   nodes[id].number=number; nodes[id].field=field;
}
void BuildNodes() {
   ArrayResize(nodes,@@NODES@@);
@@SETUP@@
   ArrayResize(features,FeatureCount);
   ArrayResize(feature_names,FeatureCount);
@@FEATURE_SETUP@@
}

double ParseNumber(string text) {
   if(StringLen(text)==0) return EMPTY_VALUE;
   bool digit=false,exponent_digit=false,dot=false,exponent=false;
   for(int k=0;k<StringLen(text);k++) {
      ushort ch=StringGetCharacter(text,k);
      if(ch>='0' && ch<='9') { if(exponent) exponent_digit=true; else digit=true; continue; }
      if((ch=='-' || ch=='+') && (k==0 || StringGetCharacter(text,k-1)=='e' || StringGetCharacter(text,k-1)=='E')) continue;
      if(ch=='.' && !dot && !exponent) { dot=true; continue; }
      if((ch=='e' || ch=='E') && digit && !exponent) { exponent=true; continue; }
      return EMPTY_VALUE;
   }
   return digit && (!exponent || exponent_digit) ? Clean(StringToDouble(text)) : EMPTY_VALUE;
}

bool LoadFeatures(int count) {
   if(FeatureCount==0) return true;
   for(int k=0;k<FeatureCount;k++) {
      ArrayResize(features[k].v,count); ArrayInitialize(features[k].v,EMPTY_VALUE);
   }
   int file=FileOpen(FeatureFile,FILE_READ|FILE_CSV|FILE_ANSI|FILE_COMMON,';',CP_UTF8);
   if(file==INVALID_HANDLE) { Print("Required feature file unavailable: ",FeatureFile); return false; }
   bool valid=(FileReadString(file)=="timestamp_utc");
   for(int k=0;k<FeatureCount;k++) if(FileReadString(file)!=feature_names[k]) valid=false;
   if(!valid) { FileClose(file); Print("Feature header mismatch"); return false; }
   int index=0;
   datetime previous=0;
   while(!FileIsEnding(file)) {
      string stamp=FileReadString(file);
      if(stamp=="" && FileIsEnding(file)) break;
      datetime when=(datetime)StringToInteger(stamp);
      if(when<=previous) { FileClose(file); Print("Feature dates must be ordered and unique"); return false; }
      previous=when;
      while(index<count && UtcTime(bars[index].time)<when) index++;
      for(int k=0;k<FeatureCount;k++) {
         double value=ParseNumber(FileReadString(file));
         if(index<count && UtcTime(bars[index].time)==when) features[k].v[index]=value;
      }
   }
   FileClose(file);
   return true;
}

double FieldValue(string name,int i) {
   if(name=="open") return bars[i].open;
   if(name=="high") return bars[i].high;
   if(name=="low") return bars[i].low;
   if(name=="close") return bars[i].close;
   if(name=="weekday" || name=="day" || name=="month") {
      MqlDateTime stamp; TimeToStruct(UtcTime(bars[i].time),stamp);
      if(name=="weekday") return (stamp.day_of_week+6)%7;
      if(name=="month") return stamp.mon;
      return stamp.day;
   }
   for(int k=0;k<FeatureCount;k++) if(name==feature_names[k]) return features[k].v[i];
   return EMPTY_VALUE;
}

double Binary(string op,double a,double b) {
   if(op=="and") return Both(a,b);
   if(op=="or") return Either(a,b);
   if(!Valid(a) || !Valid(b)) return EMPTY_VALUE;
   if(op=="add") return Clean(a+b);
   if(op=="sub") return Clean(a-b);
   if(op=="mul") return Clean(a*b);
   if(op=="div") return b!=0 ? Clean(a/b) : EMPTY_VALUE;
   if(op=="gt") return a>b ? 1.0 : 0.0;
   if(op=="ge") return a>=b ? 1.0 : 0.0;
   if(op=="lt") return a<b ? 1.0 : 0.0;
   if(op=="le") return a<=b ? 1.0 : 0.0;
   if(op=="eq") return a==b ? 1.0 : 0.0;
   if(op=="ne") return a!=b ? 1.0 : 0.0;
   return EMPTY_VALUE;
}

double WindowValue(string op,int a,int b,int c,int i) {
   int window=(int)nodes[op=="corr" ? c : b].v[i];
   if(window<1 || i<window-1) return EMPTY_VALUE;
   double sum=0,other_sum=0,minimum=EMPTY_VALUE,maximum=-DBL_MAX;
   double values[];
   if(op=="quantile") ArrayResize(values,window);
   for(int j=0;j<window;j++) {
      double x=nodes[a].v[i-window+1+j];
      if(!Valid(x)) return EMPTY_VALUE;
      sum+=x; minimum=MathMin(minimum,x); maximum=MathMax(maximum,x);
      if(op=="quantile") values[j]=x;
      if(op=="corr") {
         double y=nodes[b].v[i-window+1+j];
         if(!Valid(y)) return EMPTY_VALUE;
         other_sum+=y;
      }
   }
   if(op=="total") return Clean(sum);
   if(op=="sma") return Clean(sum/window);
   if(op=="lowest") return minimum;
   if(op=="highest") return maximum;
   if(op=="rank") {
      int less=0,equal=0;
      for(int j=i-window+1;j<=i;j++) {
         if(nodes[a].v[j]<nodes[a].v[i]) less++;
         if(nodes[a].v[j]==nodes[a].v[i]) equal++;
      }
      return (less+(equal+1.0)/2.0)/window;
   }
   if(op=="quantile") {
      ArraySort(values);
      double position=(window-1)*nodes[c].v[i];
      int left=(int)MathFloor(position),right=(int)MathCeil(position);
      return values[left]+(values[right]-values[left])*(position-left);
   }
   if(window<2) return EMPTY_VALUE;
   double mean=sum/window,other_mean=other_sum/window,var=0,other_var=0,cov=0;
   for(int j=i-window+1;j<=i;j++) {
      double dx=nodes[a].v[j]-mean; var+=dx*dx;
      if(op=="corr") {
         double dy=nodes[b].v[j]-other_mean; other_var+=dy*dy; cov+=dx*dy;
      }
   }
   if(op=="std") return Clean(MathSqrt(var/(window-1)));
   return var>0 && other_var>0 ? Clean(cov/MathSqrt(var*other_var)) : EMPTY_VALUE;
}

void EvaluateNode(int id,int count) {
   string op=nodes[id].op;
   int a=nodes[id].a,b=nodes[id].b,c=nodes[id].c;
   ArrayResize(nodes[id].v,count); ArrayInitialize(nodes[id].v,EMPTY_VALUE);
   if(op=="ema") {
      double weighted=EMPTY_VALUE,old_weight=1.0;
      int observations=0;
      for(int i=0;i<count;i++) {
         int span=(int)nodes[b].v[i];
         double alpha=2.0/(span+1),x=nodes[a].v[i];
         if(Valid(x)) observations++;
         if(Valid(weighted)) {
            old_weight*=1.0-alpha;
            if(Valid(x)) {
               double new_weight=(EmaSpan3GapCorrection && span==3) ? 1.0-old_weight : alpha;
               if(weighted!=x) weighted=(old_weight*weighted+new_weight*x)/(old_weight+new_weight);
               old_weight=1.0;
            }
         } else if(Valid(x)) weighted=x;
         if(observations>=span) nodes[id].v[i]=Clean(weighted);
      }
      return;
   }
   for(int i=0;i<count;i++) {
      if(op=="constant") { nodes[id].v[i]=nodes[id].number; continue; }
      if(op=="field") { nodes[id].v[i]=FieldValue(nodes[id].field,i); continue; }
      double x=nodes[a].v[i];
      if(op=="lag" || op=="pct" || op=="change") {
         int lag=(int)nodes[b].v[i];
         if(i<lag) continue;
         double past=nodes[a].v[i-lag];
         if(op=="lag") nodes[id].v[i]=past;
         else if(Valid(x) && Valid(past)) nodes[id].v[i]=(op=="change") ? Clean(x-past) : (past!=0 ? Clean(x/past-1.0) : EMPTY_VALUE);
         continue;
      }
      if(op=="sma" || op=="std" || op=="lowest" || op=="highest" || op=="total" || op=="rank" || op=="quantile" || op=="corr") {
         nodes[id].v[i]=WindowValue(op,a,b,c,i); continue;
      }
      if(op=="where") {
         if(Valid(x)) nodes[id].v[i]=Yes(x) ? nodes[b].v[i] : nodes[c].v[i];
         continue;
      }
      if(b>=0) { nodes[id].v[i]=Binary(op,x,nodes[b].v[i]); continue; }
      if(!Valid(x)) continue;
      if(op=="not") nodes[id].v[i]=No(x) ? 1.0 : 0.0;
      else if(op=="neg") nodes[id].v[i]=Clean(-x);
      else if(op=="positive") nodes[id].v[i]=x;
      else if(op=="abs") nodes[id].v[i]=MathAbs(x);
      else if(op=="log" && x>0) nodes[id].v[i]=MathLog(x);
      else if(op=="sqrt" && x>=0) nodes[id].v[i]=MathSqrt(x);
   }
}

bool EvaluateSignals(bool &entry,bool &exit_signal) {
   entry=false; exit_signal=false;
   ArraySetAsSeries(bars,false);
   int count=CopyRates(BrokerSymbol,SignalTimeframe,HistoryStart+BrokerUtcOffsetMinutes*60,TimeCurrent(),bars);
   if(count<Warmup+3) { Print("Insufficient signal history"); return false; }
   if(bars[count-1].time!=iTime(BrokerSymbol,SignalTimeframe,0)) return false;
   if(UtcTime(bars[0].time)!=HistoryStart) { Print("Historical start mismatch; refusing changed EMA initialization"); return false; }
   if(!LoadFeatures(count)) return false;
   int closed=count-2;
   for(int k=0;k<FeatureCount;k++) if(!Valid(features[k].v[closed])) {
      Print("Missing exact-date feature: ",feature_names[k]); return false;
   }
   for(int id=0;id<ArraySize(nodes);id++) EvaluateNode(id,count);
   entry=Yes(nodes[@@ENTRY@@].v[closed]);
   exit_signal=LegacyExit ? !entry : Yes(nodes[@@EXIT@@].v[closed]);
   if(EmitSignalLog) PrintFormat("QUANTLAB_SIGNAL %I64d entry=%d exit=%d",(long)UtcTime(bars[closed].time),(int)entry,(int)exit_signal);
   return true;
}

// Return false on any foreign/ambiguous position, including netting interference.
bool ManagedPosition(ulong &ticket) {
   ticket=0;
   for(int i=OrdersTotal()-1;i>=0;i--) {
      if(OrderGetTicket(i)!=0 && OrderGetString(ORDER_SYMBOL)==BrokerSymbol) {
         Print("Outstanding order on strategy symbol; wait before another request"); return false;
      }
   }
   for(int i=PositionsTotal()-1;i>=0;i--) {
      ulong selected=PositionGetTicket(i);
      if(selected==0 || PositionGetString(POSITION_SYMBOL)!=BrokerSymbol) continue;
      if((ulong)PositionGetInteger(POSITION_MAGIC)!=MagicNumber || ticket!=0 || PositionGetInteger(POSITION_TYPE)!=(Direction>0 ? POSITION_TYPE_BUY : POSITION_TYPE_SELL)) {
         Print("Foreign or ambiguous position on strategy symbol; no action"); return false;
      }
      ticket=selected;
   }
   return ticket==0 || PositionSelectByTicket(ticket);
}

double PositionLots(double ask) {
   double contract=SymbolInfoDouble(BrokerSymbol,SYMBOL_TRADE_CONTRACT_SIZE);
   double step=SymbolInfoDouble(BrokerSymbol,SYMBOL_VOLUME_STEP);
   double minimum=SymbolInfoDouble(BrokerSymbol,SYMBOL_VOLUME_MIN);
   double maximum=SymbolInfoDouble(BrokerSymbol,SYMBOL_VOLUME_MAX);
   if(ask<=0 || contract<=0 || step<=0 || minimum<=0) return 0;
   if(!HistorySelect(HistoryStart,TimeCurrent())) return 0;
   double strategy_cash=StrategyCapitalUSD;
   for(int i=0;i<HistoryDealsTotal();i++) {
      ulong deal=HistoryDealGetTicket(i);
      if(deal==0 || HistoryDealGetString(deal,DEAL_SYMBOL)!=BrokerSymbol || (ulong)HistoryDealGetInteger(deal,DEAL_MAGIC)!=MagicNumber) continue;
      strategy_cash+=HistoryDealGetDouble(deal,DEAL_PROFIT)+HistoryDealGetDouble(deal,DEAL_COMMISSION)
                     +HistoryDealGetDouble(deal,DEAL_SWAP)+HistoryDealGetDouble(deal,DEAL_FEE);
   }
   double available=MathMin(strategy_cash,MathMin(AccountInfoDouble(ACCOUNT_BALANCE),AccountInfoDouble(ACCOUNT_MARGIN_FREE)));
   if(available<=0) return 0;
   double lots=MathFloor(available*Allocation/(ask*contract)/step)*step;
   lots=NormalizeDouble(MathMin(maximum,lots),8);
   if(lots<minimum || lots*contract*ask>available*Allocation+0.000001) return 0;
   double margin=0;
   if(!OrderCalcMargin(Direction>0 ? ORDER_TYPE_BUY : ORDER_TYPE_SELL,BrokerSymbol,lots,ask,margin) || margin>AccountInfoDouble(ACCOUNT_MARGIN_FREE)) return 0;
   return lots;
}

// Observed quotes and signals only. No assertion of a fill for an unsent order.
void WriteShadow(datetime current,bool entry,bool exit_signal) {
   MqlTick observed;
   if(!SymbolInfoTick(BrokerSymbol,observed)) return;
   int file=FileOpen("quantlab_shadow_@@SHORT_SIGNATURE@@.csv",FILE_READ|FILE_WRITE|FILE_CSV|FILE_ANSI|FILE_COMMON,';');
   if(file==INVALID_HANDLE) { Print("Shadow log unavailable"); return; }
   if(FileSize(file)==0) FileWrite(file,"timestamp","signal_timestamp","entry","exit","direction","bid","ask","trading_enabled");
   FileSeek(file,0,SEEK_END);
   FileWrite(file,(long)UtcTime(observed.time),(long)UtcTime(iTime(BrokerSymbol,SignalTimeframe,1)),(int)entry,(int)exit_signal,Direction,observed.bid,observed.ask,(int)EnableTrading);
   FileFlush(file); FileClose(file);
}

int OnInit() {
   if(BrokerSymbol=="" || !SymbolSelect(BrokerSymbol,true)) return INIT_PARAMETERS_INCORRECT;
   if(_Symbol!=BrokerSymbol || _Period!=SignalTimeframe) { Print("Attach EA to BrokerSymbol signal timeframe chart"); return INIT_PARAMETERS_INCORRECT; }
   if(StrategyCapitalUSD<=0 || MaxEntryDelaySeconds<0) return INIT_PARAMETERS_INCORRECT;
   if(AccountInfoString(ACCOUNT_CURRENCY)!="USD" || SymbolInfoString(BrokerSymbol,SYMBOL_CURRENCY_PROFIT)!="USD") {
      Print("Sizing requires USD account and USD quote currency"); return INIT_PARAMETERS_INCORRECT;
   }
   string expected=@@SYMBOL@@;
   if(StringLen(expected)==6 && StringSubstr(expected,3)=="USD" && SymbolInfoString(BrokerSymbol,SYMBOL_CURRENCY_BASE)!=StringSubstr(expected,0,3)) {
      Print("Instrument orientation/base currency mismatch"); return INIT_PARAMETERS_INCORRECT;
   }
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(MaxDeviationPoints);
   trade.SetAsyncMode(false);
   if(!trade.SetTypeFillingBySymbol(BrokerSymbol)) return INIT_FAILED;
   BuildNodes();
   last_bar=iTime(BrokerSymbol,SignalTimeframe,0); // No retroactive entry on attachment.
   await_first_bar=(last_bar==0);
   return INIT_SUCCEEDED;
}

void OnTick() {
   datetime current=iTime(BrokerSymbol,SignalTimeframe,0);
   if(current==0 || current==last_bar) return;
   if(await_first_bar) { last_bar=current; await_first_bar=false; return; }
   if(TimeCurrent()==last_evaluation) return;
   last_evaluation=TimeCurrent();
   bool entry=false,exit_signal=false;
   bool ready=EvaluateSignals(entry,exit_signal);
   last_bar=ready ? current : 0; // Retry unavailable data without late entries.
   if(ready) WriteShadow(current,entry,exit_signal);
   if(!EnableTrading) return;
   ulong ticket=0;
   if(!ManagedPosition(ticket)) return;
   if(ticket!=0) {
      double previous=iClose(BrokerSymbol,SignalTimeframe,1);
      double price=PositionGetDouble(POSITION_PRICE_OPEN);
      int age=iBarShift(BrokerSymbol,SignalTimeframe,(datetime)PositionGetInteger(POSITION_TIME),false);
      bool protective=previous>0 && (Direction*(previous/price-1)<=-StopFraction || Direction*(previous/price-1)>=TakeFraction);
      if((ready && exit_signal) || protective || age>=MaxHolding) {
         bool sent=trade.PositionClose(ticket,MaxDeviationPoints);
         uint code=trade.ResultRetcode();
         if(!sent || code!=TRADE_RETCODE_DONE) {
            Print("Close not fully executed: ",code," ",trade.ResultRetcodeDescription());
            last_bar=0; // Retry outstanding exits on subsequent ticks; never open in this branch.
         }
      }
      return;
   }
   if(!ready || !entry || exit_signal || TimeCurrent()-current>MaxEntryDelaySeconds) return;
   MqlTick tick;
   if(!SymbolInfoTick(BrokerSymbol,tick)) return;
   double lots=PositionLots(Direction>0 ? tick.ask : tick.bid);
   if(lots<=0) { Print("Insufficient cash for broker minimum without leverage"); return; }
   // No broker SL/TP: the tested rules detect stops at signal close.
   bool sent=Direction>0 ? trade.Buy(lots,BrokerSymbol,0.0,0.0,0.0,"QuantLab") : trade.Sell(lots,BrokerSymbol,0.0,0.0,0.0,"QuantLab");
   uint code=trade.ResultRetcode();
   if(!sent || (code!=TRADE_RETCODE_DONE && code!=TRADE_RETCODE_DONE_PARTIAL))
      Print("Entry not executed: ",code," ",trade.ResultRetcodeDescription());
}
