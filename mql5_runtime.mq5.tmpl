input bool EnableTrading=false;
input bool EmitSignalLog=true;
input double StrategyCapitalUSD=100.0;
input ulong MagicNumber=@@MAGIC@@;
input ulong MaxDeviationPoints=20;
input int MaxEntryDelaySeconds=60;
input int BrokerUtcOffsetMinutes=0;
input datetime HistoryStart=(datetime)@@START@@;
